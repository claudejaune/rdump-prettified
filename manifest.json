
{
  "manifest_version": 3,
  "version": "0.8",
  "name": "rdump",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "downloads",
    "storage"
  ],
  
   "action": {
     "default_popup": "popup.html"
   }
}
